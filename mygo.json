{
  "name": "Vibe",
  "identifier": "dev.vibe.ide",
  "version": "0.2.4",
  "main": "./cmd/vibe",
  "urlSchemes": [
    "vibe"
  ],
  "fileAssociations": [
    {
      "name": "Plain Text",
      "ext": [
        "txt",
        "text",
        "log"
      ],
      "mimeType": "text/plain"
    },
    {
      "name": "Markdown Document",
      "ext": [
        "md",
        "markdown"
      ],
      "mimeType": "text/markdown"
    },
    {
      "name": "JSON Document",
      "ext": [
        "json"
      ],
      "mimeType": "application/json"
    },
    {
      "name": "XML Document",
      "ext": [
        "xml"
      ],
      "mimeType": "application/xml"
    },
    {
      "name": "YAML Document",
      "ext": [
        "yaml",
        "yml"
      ],
      "mimeType": "application/yaml"
    },
    {
      "name": "HTML Document",
      "ext": [
        "html",
        "htm"
      ],
      "mimeType": "text/html"
    },
    {
      "name": "CSS Stylesheet",
      "ext": [
        "css"
      ],
      "mimeType": "text/css"
    },
    {
      "name": "CSV Document",
      "ext": [
        "csv"
      ],
      "mimeType": "text/csv"
    },
    {
      "name": "JavaScript Source",
      "ext": [
        "js",
        "mjs",
        "cjs"
      ],
      "mimeType": "text/javascript"
    }
  ],
  "out": "build",
  "i18n": {
    "dir": "locales",
    "source": "en"
  },
  "macos": {
    "minimumSystemVersion": "13.0",
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Text",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.text",
            "public.plain-text",
            "public.utf8-plain-text",
            "public.source-code",
            "public.script",
            "public.shell-script",
            "public.python-script",
            "public.ruby-script",
            "public.perl-script",
            "public.php-script",
            "com.netscape.javascript-source",
            "public.c-source",
            "public.c-header",
            "public.c-plus-plus-source",
            "public.c-plus-plus-header",
            "public.objective-c-source",
            "public.swift-source",
            "public.assembly-source",
            "net.daringfireball.markdown",
            "public.json",
            "public.xml",
            "public.yaml",
            "public.html",
            "public.css",
            "public.comma-separated-values-text",
            "public.tab-separated-values-text",
            "public.log",
            "public.svg-image",
            "com.apple.property-list",
            "com.apple.xml-property-list",
            "org.tug.tex"
          ]
        },
        {
          "CFBundleTypeName": "Source Code",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "CFBundleTypeExtensions": [
            "go",
            "mod",
            "sum",
            "rs",
            "ts",
            "tsx",
            "mts",
            "cts",
            "jsx",
            "mjs",
            "cjs",
            "vue",
            "svelte",
            "astro",
            "toml",
            "ini",
            "cfg",
            "conf",
            "env",
            "lock",
            "kt",
            "kts",
            "java",
            "scala",
            "gradle",
            "dart",
            "lua",
            "zig",
            "nim",
            "ex",
            "exs",
            "erl",
            "hs",
            "ml",
            "clj",
            "sql",
            "graphql",
            "gql",
            "proto",
            "tf",
            "hcl",
            "nix",
            "cmake",
            "bat",
            "cmd",
            "ps1",
            "fish",
            "zsh",
            "bash",
            "mdx",
            "rst",
            "adoc",
            "org",
            "tex",
            "bib",
            "less",
            "scss",
            "sass",
            "diff",
            "patch",
            "properties",
            "jsonc",
            "json5",
            "jsonl",
            "ndjson"
          ]
        },
        {
          "CFBundleTypeName": "Document",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.data"
          ]
        },
        {
          "CFBundleTypeName": "Folder",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.folder"
          ]
        }
      ]
    }
  },
  "windows": {
    "contextMenu": "Open with Vibe"
  },
  "linux": {
    "command": "vibe",
    "comment": "A terminal-first code editor",
    "categories": [
      "Development",
      "TextEditor"
    ]
  },
  "resources": [
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ]
}
